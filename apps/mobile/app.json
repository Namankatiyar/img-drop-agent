{
  "expo": {
    "name": "ImgDrop",
    "slug": "imgdrop",
    "scheme": "imgdrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "android": {
      "package": "com.imgdrop.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.imgdrop.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "ImgDrop needs camera access to capture photos and scan pairing QR codes.",
        "NSPhotoLibraryUsageDescription": "ImgDrop needs photo library access to select photos for handoff."
      }
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "26afe4da-5312-440a-9f26-1133fe2cba13"
      }
    },
    "owner": "knamans-team"
  }
}
